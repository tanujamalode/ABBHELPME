# Copy to .env and fill in from Supabase > Project Settings > API.
# Only the anon (public) key goes here. Never put the service_role key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional, for testing only: shows a password sign-in so dummy accounts (made in the Supabase dashboard with
# "Auto Confirm User") work without email. Leave this out, or false, for anything real.
EXPO_PUBLIC_DEV_LOGIN=false
